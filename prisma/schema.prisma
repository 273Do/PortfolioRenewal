// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 通知テーブル
model Notice {
  id Int @id @default(autoincrement()) //@idはPKを表す
  event_date DateTime
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ツールテーブル
model Tool{
  id Int @id @default(autoincrement()) 
  name String
  period String
  color String
  description String
  background String
  ingenuity String
  point String
  url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // fields は自身のモデル(Technology)の項目，references にはTechnologyからみた参照先のモデル(Tool)の項目をいれる
  // 主キーと外部キーの関係を示す(fields: [Tool内の外部キー], references: [Technologyの主キー])
  technology Technology? @relation(fields: [technologyId], references: [id])
  technologyId Int? @unique //FK
  genre Genre? @relation(fields: [genreId], references: [id])
  genreId Int? @unique //FK
}

// ジャンルテーブル
model Genre{
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tool Tool?
}


// 技術テーブル
model Technology{
  id Int @id @default(autoincrement())
  tech0 String
  tech1 String
  tech2 String
  tech3 String? //?(optional)をつけるとnullを許容
  tech4 String?
  tech5 String?
  tech6 String?
  tech7 String?
  tech8 String?
  tech9 String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tool Tool?
}

//  user          @relation(fields: [userId], references: [id], onDelete: Cascade)
// @relationの記述をすることで、他のテーブルに対してのリレーションを設定できます！
// fields: どのカラムを外部キーとするか
// references: 親テーブルのどのカラムを見るか
// onDelete: 親テーブルが削除された時にどのような挙動をさせるか
// → Cascadeの場合、親のレコードが削除された場合は子のレコードも削除される

// Movieテーブル
model Movie{
  id Int @id @default(autoincrement())
  title String
  description String
  url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Gallery
model Gallery{
  id Int @id @default(autoincrement())
  event_date DateTime
  title String
  description String
  url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// FAQテーブル
model Faq{
  id Int @id @default(autoincrement())
  question String
  answer String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}